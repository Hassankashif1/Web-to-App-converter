# Both of these are OPTIONAL — only needed if you're also wiring this up to
# the WordPress plugin (see SETUP.md). Using the built-in dashboard at
# http://localhost:4000 by itself needs neither.

# The WordPress site running the Web to App Builder plugin (no trailing slash).
WP_SITE_URL=https://example.com

# Must exactly match the "Build Server API Key" saved in
# WP Admin -> Web to App Builder -> Build Server Settings.
WTA_API_KEY=replace-with-a-long-random-string

# This server's own public base URL, used to build download links that get
# sent back to WordPress. If you only run this locally for yourself, leave
# it as localhost — the download link just won't work from someone else's
# browser. To let a client download a build, expose this with a tunnel
# (e.g. `ngrok http 4000`) and put that https URL here instead.
SELF_BASE_URL=http://localhost:4000

# Absolute path to the Android SDK. Required for the Gradle build step.
# Windows example: C:\Users\you\AppData\Local\Android\Sdk
# macOS example:   /Users/you/Library/Android/sdk
ANDROID_HOME=

# Absolute path to a JDK 21 install (the Capacitor Android module requires 21,
# not 17). Only needed if `java -version` doesn't already report 21+ on PATH.
# Windows example: C:\Program Files\Eclipse Adoptium\jdk-21.0.12.101-hotspot
JAVA_HOME=

# How often (ms) the worker checks data/jobs.json for new work.
POLL_INTERVAL_MS=5000
